generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Account {
  id             String         @id @default(uuid())
  userId         String
  name           String
  type           String
  initialBalance Decimal        @default(0) @db.Decimal(15, 2)
  currentBalance Decimal        @default(0) @db.Decimal(15, 2)
  description    String?
  color          String?
  logoUrl        String?
  icon           String?
  isArchived     Boolean        @default(false)
  lockedByPlan   Boolean        @default(false)
  createdAt      DateTime       @default(now())
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions   Transaction[]
  transfersFrom  Transfer[]     @relation("TransferFromAccount")
  transfersTo    Transfer[]     @relation("TransferToAccount")
  debtPayments   DebtPayment[]
  subscriptions  Subscription[]

  @@index([userId])
}

model Transaction {
  id            String       @id @default(uuid())
  accountId     String?
  debtId        String?
  userId        String
  amount        Decimal      @db.Decimal(15, 2)
  type          String
  description   String
  date          DateTime
  categoryId    String
  subcategoryId String?
  createdAt     DateTime     @default(now())
  account       Account?     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  debt          Debt?        @relation(fields: [debtId], references: [id], onDelete: Cascade)
  category      Category     @relation(fields: [categoryId], references: [id])
  subcategory   Subcategory? @relation(fields: [subcategoryId], references: [id])
  debtPayment   DebtPayment?

  @@index([userId])
  @@index([accountId])
  @@index([debtId])
  @@index([categoryId])
  @@index([subcategoryId])
}

model Category {
  id                String             @id @default(uuid())
  userId            String
  name              String
  type              String
  isDefault         Boolean            @default(false)
  defaultKey        String?
  createdAt         DateTime           @default(now())
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  subcategories     Subcategory[]
  transactions      Transaction[]
  budgetItems       BudgetItem[]
  subscriptions     Subscription[]
  recurringExpenses RecurringExpense[]

  @@unique([userId, defaultKey])
  @@index([userId])
}

model BudgetItem {
  id                 String            @id @default(uuid())
  userId             String
  categoryId         String
  subcategoryId      String?
  subscriptionId     String?
  recurringExpenseId String?
  debtId             String?
  date               DateTime
  amount             Decimal           @db.Decimal(15, 2)
  description        String
  createdAt          DateTime          @default(now())
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  category           Category          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subcategory        Subcategory?      @relation(fields: [subcategoryId], references: [id])
  subscription       Subscription?     @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  recurringExpense   RecurringExpense? @relation(fields: [recurringExpenseId], references: [id], onDelete: Cascade)
  debt               Debt?             @relation(fields: [debtId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, date])
  @@unique([recurringExpenseId, date])
  @@unique([debtId, date])
  @@index([userId])
  @@index([categoryId])
  @@index([subcategoryId])
  @@index([subscriptionId])
  @@index([recurringExpenseId])
  @@index([debtId])
  @@index([date])
}

model RecurringExpense {
  id            String       @id @default(uuid())
  userId        String
  name          String
  categoryId    String
  subcategoryId String?
  amount        Decimal      @db.Decimal(15, 2)
  frequency     String       @default("monthly")
  dueDay        Int?
  weekday       Int?
  intervalWeeks Int?
  startDate     DateTime
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subcategory   Subcategory? @relation(fields: [subcategoryId], references: [id])
  budgetItems   BudgetItem[]

  @@index([userId])
  @@index([categoryId])
}

model Subscription {
  id            String       @id @default(uuid())
  userId        String
  name          String
  categoryId    String
  subcategoryId String?
  amount        Decimal      @db.Decimal(15, 2)
  frequency     String       @default("monthly")
  dueDay        Int?
  dueMonth      Int?
  startDate     DateTime
  isActive      Boolean      @default(true)
  lockedByPlan  Boolean      @default(false)
  accountId     String?
  debtId        String?
  createdAt     DateTime     @default(now())
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subcategory   Subcategory? @relation(fields: [subcategoryId], references: [id])
  account       Account?     @relation(fields: [accountId], references: [id], onDelete: SetNull)
  debt          Debt?        @relation(fields: [debtId], references: [id], onDelete: SetNull)
  budgetItems   BudgetItem[]

  @@index([userId])
  @@index([categoryId])
  @@index([accountId])
  @@index([debtId])
}

model Subcategory {
  id                String             @id @default(uuid())
  categoryId        String
  userId            String
  name              String
  createdAt         DateTime           @default(now())
  category          Category           @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  transactions      Transaction[]
  budgetItems       BudgetItem[]
  subscriptions     Subscription[]
  recurringExpenses RecurringExpense[]

  @@index([categoryId])
  @@index([userId])
}

model Transfer {
  id            String   @id @default(uuid())
  userId        String
  fromAccountId String
  toAccountId   String
  amount        Decimal  @db.Decimal(15, 2)
  date          DateTime
  note          String?
  createdAt     DateTime @default(now())
  fromAccount   Account  @relation("TransferFromAccount", fields: [fromAccountId], references: [id], onDelete: Cascade)
  toAccount     Account  @relation("TransferToAccount", fields: [toAccountId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum Plan {
  FREE
  PRO
}

enum Role {
  ADMIN
  USER
}

model User {
  id                      String                   @id
  name                    String
  email                   String
  emailVerified           Boolean                  @default(false)
  image                   String?
  currency                String                   @default("usd")
  timezone                String                   @default("America/Bogota")
  budgetPeriod            String                   @default("monthly")
  language                String                   @default("en")
  plan                    Plan                     @default(FREE)
  role                    Role                     @default(USER)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  sessions                Session[]
  authaccounts            AuthAccount[]
  accounts                Account[]
  categories              Category[]
  debts                   Debt[]
  budgetItems             BudgetItem[]
  subscriptions           Subscription[]
  recurringExpenses       RecurringExpense[]
  feedback                Feedback[]
  mcpApiKeys              McpApiKey[]
  mcpIdempotencyKeys      McpIdempotencyKey[]
  oauthAuthorizationCodes OAuthAuthorizationCode[]
  oauthAccessTokens       OAuthAccessToken[]
  billingSubscription     BillingSubscription?

  @@unique([email])
  @@map("user")
}

model BillingSubscription {
  id                   String   @id @default(uuid())
  userId               String   @unique
  polarCustomerId      String?
  polarSubscriptionId  String   @unique
  productId            String
  status               String
  currentPeriodEnd     DateTime?
  endsAt               DateTime?
  cancelAtPeriodEnd    Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([polarCustomerId])
  @@index([status])
}

// Stores only safe processing metadata for verified Polar webhooks. The raw
// payload is intentionally not persisted because it may contain provider data
// that is unnecessary for reconciliation.
model BillingWebhookEvent {
  id            String    @id @default(uuid())
  eventId       String    @unique
  eventType     String
  status        String
  correlationId String
  processedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([eventType])
  @@index([status])
}

model McpApiKey {
  id         String    @id @default(uuid())
  userId     String
  name       String
  keyHash    String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([keyHash])
  @@index([userId])
}

// Lets MCP write tools (create_transaction, create_transfer,
// create_subscription) be safely retried by an agent after a timeout/network
// error: the same (userId, toolName, idempotencyKey) returns the original
// result instead of creating a duplicate record.
model McpIdempotencyKey {
  id             String   @id @default(uuid())
  userId         String
  toolName       String
  idempotencyKey String
  result         Json
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, toolName, idempotencyKey])
  @@index([userId])
}

model OAuthClient {
  id           String   @id @default(uuid())
  name         String
  redirectUris String[]
  createdAt    DateTime @default(now())

  authorizationCodes OAuthAuthorizationCode[]
  accessTokens       OAuthAccessToken[]
}

model OAuthAuthorizationCode {
  id            String    @id @default(uuid())
  codeHash      String    @unique
  clientId      String
  userId        String
  redirectUri   String
  codeChallenge String
  scope         String
  expiresAt     DateTime
  consumedAt    DateTime?
  createdAt     DateTime  @default(now())

  client OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([userId])
}

model OAuthAccessToken {
  id                    String    @id @default(uuid())
  accessTokenHash       String    @unique
  refreshTokenHash      String    @unique
  clientId              String
  userId                String
  scope                 String
  accessTokenExpiresAt  DateTime
  refreshTokenExpiresAt DateTime
  revokedAt             DateTime?
  createdAt             DateTime  @default(now())

  client OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([userId])
}

model Feedback {
  id        String   @id @default(uuid())
  userId    String
  name      String?
  message   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Debt {
  id               String               @id @default(uuid())
  userId           String
  name             String
  type             String               @default("loan")
  originalAmount   Decimal              @db.Decimal(15, 2)
  remainingBalance Decimal              @db.Decimal(15, 2)
  creditLimit      Decimal?             @db.Decimal(15, 2)
  minimumPayment   Decimal?             @db.Decimal(15, 2)
  paymentDueDay    Int?
  lockedByPlan     Boolean              @default(false)
  createdAt        DateTime             @default(now())
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments         DebtPayment[]
  interestCharges  DebtInterestCharge[]
  transactions     Transaction[]
  budgetItems      BudgetItem[]
  subscriptions    Subscription[]

  @@index([userId])
}

// A debt payment always mirrors itself as an expense Transaction (categorized
// under "Deuda") so it counts toward the budget and expense totals like any
// other spend. transactionId links the two records so they can be kept in
// sync and deleted together.
model DebtPayment {
  id            String       @id @default(uuid())
  debtId        String
  accountId     String
  userId        String
  amount        Decimal      @db.Decimal(15, 2)
  date          DateTime
  note          String?
  transactionId String?      @unique
  createdAt     DateTime     @default(now())
  debt          Debt         @relation(fields: [debtId], references: [id], onDelete: Cascade)
  account       Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([debtId])
  @@index([accountId])
  @@index([userId])
}

// Interest accrued on a debt: increases remainingBalance without touching
// originalAmount, keeping a separate record from principal payments so the
// two can be told apart later.
model DebtInterestCharge {
  id        String   @id @default(uuid())
  debtId    String
  userId    String
  amount    Decimal  @db.Decimal(15, 2)
  date      DateTime
  note      String?
  createdAt DateTime @default(now())
  debt      Debt     @relation(fields: [debtId], references: [id], onDelete: Cascade)

  @@index([debtId])
  @@index([userId])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model AuthAccount {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("authAccount")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
